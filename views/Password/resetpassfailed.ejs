<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset Link Expired | ShareText</title>
  <link rel="stylesheet" href="/css/login/auth.css">
</head>
<body class="auth-page">
  <main class="auth-layout">
    <a class="brand auth-brand heading" href="/" aria-label="Share Text home">
      <span class="brand-mark">
        <img class="brand-logo" src="/images/copy.png" alt="">
      </span>
      <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
    </a>

    <section class="auth-card" aria-labelledby="reset-failed-title">
      <header class="auth-card-header">
        <div class="auth-heading-row auth-result-heading">
          <span class="auth-result-icon error" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 8v5m0 3h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3l-7.5-13.1a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h2 class="auth-title" id="reset-failed-title">Reset link unavailable</h2>
        </div>
        <p class="auth-description">This password reset link is invalid or has expired. Request a new link to try again.</p>
      </header>
      <div class="auth-result-actions">
        <a href="/forgot-password" class="auth-submit">Request a new link</a>
        <a href="/login" class="auth-link auth-result-secondary">Back to sign in</a>
      </div>
    </section>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en" class="auth-page-change-password">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password | ShareText</title>
  <link rel="stylesheet" href="/css/login/auth.css">
</head>
<body class="auth-page">
  <main class="auth-layout auth-layout-change-password">
    <a class="brand auth-brand heading" href="/" aria-label="Share Text home">
      <span class="brand-mark">
        <img class="brand-logo" src="/images/copy.png" alt="">
      </span>
      <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
    </a>

    <section class="auth-card" aria-labelledby="change-password-title">
      <header class="auth-card-header">
        <div class="auth-heading-row">
          <span class="auth-section-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M8 10V7.5a4.5 4.5 0 0 1 7.7-3.2M6.5 10h11a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 3 19.5v-8A1.5 1.5 0 0 1 4.5 10H6.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 14v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <h2 class="auth-title" id="change-password-title">Change Password</h2>
        </div>
        <p class="auth-description">Set a new password for <strong><%= email %></strong>.</p>
      </header>

      <form class="form1 auth-form auth-password-change-form" method="POST" action="/forgot-password/<%= token %>">
        <div class="auth-field-group">
          <label class="auth-field-label" for="new-password">New password</label>
          <span class="auth-field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
            </svg>
          </span>
          <input id="new-password" name="text" type="password" class="form-control auth-field" autocomplete="new-password" minlength="6" required>
        </div>
        <div class="auth-field-group">
          <label class="auth-field-label" for="confirm-password">Confirm new password</label>
          <span class="auth-field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
            </svg>
          </span>
          <input id="confirm-password" name="password" type="password" class="form-control auth-field" autocomplete="new-password" minlength="6" required>
        </div>
        <p class="info-text auth-feedback" role="alert" aria-live="polite"></p>
        <button type="submit" class="auth-submit">Update password</button>
      </form>

      <p class="auth-footer"><a class="auth-link" href="/login">Back to sign in</a></p>
    </section>
  </main>

  <script>
const infoText = document.querySelector('.info-text');
document.querySelector('.form1').addEventListener('submit', function (e) {
  e.preventDefault();

  const newPassword = document.querySelector('[name="text"]').value;
  const confirmPassword = document.querySelector('[name="password"]').value;

  if (newPassword.length >= 6 && newPassword === confirmPassword) {
    infoText.textContent = '';
    this.submit();
  } else {
    infoText.textContent = "Passwords must be at least 6 characters long and must match.";
  }
});
  </script>
</body>
</html>

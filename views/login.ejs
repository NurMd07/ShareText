<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Share Text</title>

    <link rel="stylesheet" href="/bootstrap/bootstrap_4.0.min.css" />
    <link rel="stylesheet" href="/css/login/auth.css" />
  </head>
  <body class="auth-page auth-login-page">
    <main class="auth-layout">
      <a class="brand auth-brand heading" href="/" aria-label="Share Text home">
        <span class="brand-mark">
          <img class="brand-logo" src="/images/copy.png" alt="" />
        </span>
        <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
      </a>

      <section class="auth-card" aria-labelledby="login-title">
        <header class="auth-card-header">
          <div class="auth-heading-row">
            <span class="auth-section-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M8 10V7.5a4.5 4.5 0 0 1 7.7-3.2M6.5 10h11a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 3 19.5v-8A1.5 1.5 0 0 1 4.5 10H6.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 14v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
            <h2 class="auth-title" id="login-title">Welcome back</h2>
          </div>
          <p class="auth-description">Sign in to continue.</p>
        </header>

        <form method="POST" action="/login" class="form1 auth-form" onsubmit="return validateForm()">
          <div class="auth-field-group">
            <label class="auth-field-label" for="login-username">Username</label>
            <span class="auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.1 0-7 2.1-7 4.5V20h14v-1.5c0-2.4-2.9-4.5-7-4.5Z"/>
              </svg>
            </span>
            <input id="login-username" name="username" type="text" class="form-control auth-field inp1" autocomplete="username" autocapitalize="none" placeholder="Enter your username or email" required />
          </div>
          <div class="auth-field-group">
            <label class="auth-field-label" for="login-password">Password</label>
            <span class="auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
              </svg>
            </span>
            <input id="login-password" name="password" type="password" class="form-control auth-field inp2" autocomplete="current-password" placeholder="Enter your password" required />
          </div>
          <div class="auth-links">
            <a class="auth-link su2" href="/forgot-password">Forgot password?</a>
          </div>
          <div class="login-text auth-feedback" role="alert" aria-live="polite"><% if (error) { %><%= error %><% } %></div>
          <button type="submit" class="auth-submit s1">
            Sign in <span class="auth-spinner load" aria-hidden="true"></span>
          </button>
        </form>

        <p class="auth-footer">New to ShareText?<a class="auth-link su1" href="/signup">Create an account</a></p>
      </section>

    </main>
    <%- include("partials/auth-page-menu") %>
    <script src="/js/login/login.js"></script>
    <script src="/js/login/auth-menu.js"></script>
  </body>
</html>

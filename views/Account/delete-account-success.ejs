<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Account Deleted | ShareText</title>
  <link rel="stylesheet" href="/css/login/auth.css">
</head>
<body class="auth-page auth-page-delete-account">
  <main class="auth-layout auth-layout-account">
    <a class="brand auth-brand heading" href="/" aria-label="ShareText home">
      <span class="brand-mark">
        <img class="brand-logo" src="/images/copy.png" alt="">
      </span>
      <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
    </a>

    <section class="auth-card" aria-labelledby="delete-success-title">
      <header class="auth-card-header">
        <div class="auth-heading-row auth-result-heading">
          <span class="auth-result-icon success" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="m5 12.5 4.5 4.5L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h2 class="auth-title" id="delete-success-title">Account deleted</h2>
        </div>
        <p class="auth-description">Your ShareText account and its saved text and backups have been deleted.</p>
      </header>
      <div class="auth-result-actions">
        <a href="/login" class="auth-submit">Return to sign in</a>
      </div>
    </section>
  </main>
  <%- include("../partials/auth-page-menu") %>
  <script src="/js/login/auth-menu.js"></script>
</body>
</html>

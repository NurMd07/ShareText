<!DOCTYPE html>
<html lang="en" class="auth-page-change-password">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password | ShareText</title>
  <link rel="stylesheet" href="/css/login/auth.css">
</head>
<body class="auth-page auth-page-change-password-current">
  <main class="auth-layout auth-layout-account auth-layout-change-password">
    <a class="brand auth-brand heading" href="/" aria-label="ShareText home">
      <span class="brand-mark">
        <img class="brand-logo" src="/images/copy.png" alt="">
      </span>
      <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
    </a>

    <section class="auth-card" aria-labelledby="account-password-title">
      <header class="auth-card-header">
        <div class="auth-heading-row">
          <span class="auth-section-icon auth-key-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none">
              <path d="M10.5 2.5a3 3 0 0 0-3.8 3.8l-4.2 4.2V13h2.5v-1.5h1.5V10h1.5l1-1a3 3 0 0 0 1.5-6.5ZM11 5h.01" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h2 class="auth-title" id="account-password-title">Change password</h2>
        </div>
        <p class="auth-description">Confirm your account details and choose a new password.</p>
      </header>

      <% if (feedback) { %>
        <p class="auth-feedback <%= feedbackType === 'success' ? 'auth-feedback-success' : '' %>" role="status" aria-live="polite"><%= feedback %></p>
      <% } %>

      <form class="auth-form auth-account-form" method="POST" action="/change-password">
        <div class="auth-field-group">
          <label class="auth-field-label" for="account-identifier">Username or email</label>
          <span class="auth-field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.1 0-7 2.1-7 4.5V20h14v-1.5c0-2.4-2.9-4.5-7-4.5Z"/>
            </svg>
          </span>
          <input id="account-identifier" name="identifier" type="text" class="form-control auth-field" autocomplete="username" autocapitalize="none" placeholder="Enter your username or email" required>
        </div>
        <div class="auth-field-group">
          <label class="auth-field-label" for="current-password">Current password</label>
          <span class="auth-field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
            </svg>
          </span>
          <input id="current-password" name="currentPassword" type="password" class="form-control auth-field" autocomplete="current-password" minlength="6" placeholder="Enter your current password" required>
        </div>
        <div class="auth-field-group">
          <label class="auth-field-label" for="new-password">New password</label>
          <span class="auth-field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
            </svg>
          </span>
          <input id="new-password" name="newPassword" type="password" class="form-control auth-field" autocomplete="new-password" minlength="6" placeholder="Enter your new password" required>
        </div>
        <div class="auth-field-group">
          <label class="auth-field-label" for="confirm-password">Confirm new password</label>
          <span class="auth-field-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
            </svg>
          </span>
          <input id="confirm-password" name="confirmPassword" type="password" class="form-control auth-field" autocomplete="new-password" minlength="6" placeholder="Confirm your new password" required>
        </div>
        <button type="submit" class="auth-submit">Update password</button>
      </form>

      <p class="auth-footer"><a class="auth-link" href="/login">Back to sign in</a></p>
    </section>
  </main>
  <%- include("../partials/auth-page-menu") %>
  <script src="/js/login/auth-menu.js"></script>
</body>
</html>

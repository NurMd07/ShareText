<!DOCTYPE html>
<html lang="en" class="auth-contact-page">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact ShareText</title>
    <link rel="stylesheet" href="/css/login/auth.css">
  </head>
  <body class="auth-page auth-contact-page">
    <a class="brand auth-brand heading" href="/" aria-label="ShareText home">
      <span class="brand-mark">
        <img class="brand-logo" src="/images/copy.png" alt="">
      </span>
      <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
    </a>

    <main class="auth-layout auth-layout-contact">
      <section class="auth-card auth-card-contact" aria-labelledby="contact-title">
        <header class="auth-card-header">
          <div class="auth-heading-row">
            <span class="auth-section-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke="currentColor" stroke-width="1.8"/>
                <path d="m5 7 7 5.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <h2 class="auth-title" id="contact-title">Contact us</h2>
          </div>
          <p class="auth-description">Have a question or suggestion? Send our team a message.</p>
        </header>

        <div class="auth-contact-grid">
          <aside class="auth-contact-info">
            <h3>We’re here to help</h3>
            <p>Tell us what you need and we’ll get back to you as soon as we can.</p>
            <div class="auth-contact-detail">
              <span class="auth-contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke="currentColor" stroke-width="1.8"/>
                  <path d="m5 7 7 5.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <div>
                <span class="auth-contact-label">Support email</span>
                <% if (email) { %>
                  <a class="auth-contact-value" href="mailto:<%= email %>"><%= email %></a>
                <% } else { %>
                  <span class="auth-contact-value">Email support is currently unavailable.</span>
                <% } %>
              </div>
            </div>
            <div class="auth-contact-detail">
              <span class="auth-contact-detail-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                  <circle cx="12" cy="10" r="2.3" stroke="currentColor" stroke-width="1.8"/>
                </svg>
              </span>
              <div>
                <span class="auth-contact-label">ShareText</span>
                <a class="auth-contact-value" href="/">Visit the app</a>
              </div>
            </div>
          </aside>

          <div class="auth-contact-form-wrap">
            <div id="form-message-warning" class="auth-contact-notice warning" role="alert" aria-live="assertive"></div>
            <div id="form-message-success" class="auth-contact-notice success" role="status" aria-live="polite">
              Thanks for reaching out. Your message has been received.
            </div>
            <form method="POST" action="/support" id="contactForm" name="contactForm" class="auth-form auth-contact-form">
              <div class="auth-field-group">
                <label class="auth-field-label" for="name">Name</label>
                <span class="auth-field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.1 0-7 2.1-7 4.5V20h14v-1.5c0-2.4-2.9-4.5-7-4.5Z"/>
                  </svg>
                </span>
                <input type="text" class="form-control auth-field" name="name" id="name" autocomplete="name" minlength="5" maxlength="50" placeholder="Enter your name" required>
              </div>
              <div class="auth-field-group">
                <label class="auth-field-label" for="email">Email address</label>
                <span class="auth-field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="m5 7 7 5.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <input type="email" class="form-control auth-field" name="email" id="email" autocomplete="email" minlength="7" maxlength="50" placeholder="Enter your email address" required>
              </div>
              <div class="auth-field-group">
                <label class="auth-field-label" for="subject">Subject</label>
                <span class="auth-field-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M6 4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5v15a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19.5v-15Z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M9 8h6m-6 4h6m-6 4h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </span>
                <input type="text" class="form-control auth-field" name="subject" id="subject" minlength="5" maxlength="200" placeholder="Enter a subject" required>
              </div>
              <div class="auth-field-group auth-contact-message-group">
                <label class="auth-field-label" for="message">Message</label>
                <span class="auth-field-icon auth-field-icon-top" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v10a1.5 1.5 0 0 1-1.5 1.5h-9L5 20v-3h-.5A1.5 1.5 0 0 1 3 15.5v-10Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                    <path d="M7 8h10M7 11h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </span>
                <textarea class="form-control auth-field auth-contact-message" name="message" id="message" rows="5" minlength="10" maxlength="500" placeholder="Write your message" required></textarea>
              </div>
              <button type="submit" class="auth-submit auth-contact-submit">Send message</button>
              <div class="submitting auth-contact-loading" role="status" aria-live="polite"></div>
            </form>
          </div>
        </div>

        <p class="auth-footer"><a class="auth-link" href="/">Back to ShareText</a></p>
      </section>
    </main>
    <%- include("partials/auth-page-menu") %>

    <script src="/js/jquery/jquery.min.js"></script>
    <script src="/js/jquery/jquery.validate.min.js"></script>
    <script src="/js/contactus/main.js"></script>
    <script src="/js/login/auth-menu.js"></script>
  </body>
</html>

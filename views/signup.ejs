<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Share Text</title>

    <link rel="stylesheet" href="/bootstrap/bootstrap_4.0.min.css">
    <link rel="stylesheet" href="/css/login/auth.css" />
</head>
<body class="auth-page">
    <main class="auth-layout auth-layout-signup">
      <a class="brand auth-brand heading" href="/" aria-label="Share Text home">
        <span class="brand-mark">
          <img class="brand-logo" src="/images/copy.png" alt="" />
        </span>
        <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
      </a>

      <section class="auth-card" aria-labelledby="signup-title">
        <header class="auth-card-header">
          <div class="auth-heading-row auth-signup-heading">
            <span class="auth-section-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M15.5 20v-1.5a4 4 0 0 0-4-4h-5a4 4 0 0 0-4 4V20m6.5-9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8-7v6m3-3h-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <h2 class="auth-title" id="signup-title">Sign Up</h2>
          </div>
          <p class="auth-description">A few details and you're ready.</p>
        </header>

        <form method="POST" action="/signup" class="auth-form">
          <div class="auth-field-group">
            <label class="auth-field-label" for="signup-username">Username</label>
            <span class="auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.1 0-7 2.1-7 4.5V20h14v-1.5c0-2.4-2.9-4.5-7-4.5Z"/>
              </svg>
            </span>
            <input id="signup-username" name="username" type="text" class="form-control auth-field mb-0" autocomplete="username" autocapitalize="none" placeholder="Enter your username" required>
            <label class="uerror auth-field-error d-none"></label>
          </div>
          <div class="auth-field-group">
            <label class="auth-field-label" for="signup-email">Email address</label>
            <span class="auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke="currentColor" stroke-width="1.8"/>
                <path d="m5 7 7 5.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <input id="signup-email" name="email" type="email" class="form-control auth-field mb-0" autocomplete="email" placeholder="Enter your email" required>
            <label class="eerror auth-field-error d-none"></label>
          </div>
          <div class="auth-field-group">
            <label class="auth-field-label" for="signup-password">Password</label>
            <span class="auth-field-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M7 10V7a5 5 0 0 1 10 0v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h6V7a3 3 0 0 0-6 0v3Z"/>
              </svg>
            </span>
            <input id="signup-password" name="password" type="password" class="form-control auth-field mb-0" autocomplete="new-password" placeholder="Create a password" required>
            <label class="perror auth-field-error d-none"></label>
          </div>
          <div class="login-text auth-feedback" role="alert" aria-live="polite"></div>
          <button type="submit" class="auth-submit signup">Create account <span class="auth-spinner load" aria-hidden="true"></span></button>
        </form>

        <p class="auth-footer">Already have an account?<a class="auth-link login" href="/login">Sign in</a></p>
      </section>
    </main>
    <%- include("partials/auth-page-menu") %>
      
<script>
 
   
       let login = document.querySelector('.login');
    login.addEventListener('click',()=>{
        window.location.href="/login";
    })
    let logintext = document.querySelector(".login-text");
    let heading = document.querySelector(".heading");
    heading.addEventListener("click", function () {
       window.open('/',"_self")
    });

    document.addEventListener("DOMContentLoaded", function() {
           
    let load = document.querySelector(".load");
    load.style.display ="none";
    const form = document.querySelector("form");
    const usernameInput = form.querySelector('input[name="username"]');
    const emailInput = form.querySelector('input[name="email"]');
    const passwordInput = form.querySelector('input[name="password"]');
    const errors = {
        username: "username must be at least 5 characters.",
        email: "Please enter a valid email address.",
        password: "Password must be at least 6 characters.",
        nametaken:"Username already taken",
        emailtaken:"Email already taken"
    }

    let isFetching = false;

    form.addEventListener("submit", function(event) {
       
        event.preventDefault(); // Prevent form submission
      
        
        let hasError = false;

      
            if (isFetching) {
    console.log("A fetch request is already in progress. Please wait.");
load.style.display ="inline-block";
    return;
  } 


        // Reset previous error styles
        usernameInput.classList.remove("error");
        emailInput.classList.remove("error");
        passwordInput.classList.remove("error");
        usernameInput.nextElementSibling.classList.add("d-none");
        emailInput.nextElementSibling.classList.add("d-none");
        passwordInput.nextElementSibling.classList.add("d-none");

        // Validate username (minimum 5 characters)
        if (usernameInput.value.length < 5) {
            usernameInput.classList.add("error");
            usernameInput.nextElementSibling.classList.remove("d-none");
            usernameInput.nextElementSibling.innerHTML = errors.username;
            hasError = true;
           
        }

        // Validate email format
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(emailInput.value)) {
            emailInput.classList.add("error");
            emailInput.nextElementSibling.classList.remove("d-none");
            emailInput.nextElementSibling.innerHTML = errors.email;
            hasError = true;
        }

        // Validate password (minimum 6 characters)
        if (passwordInput.value.length < 6) {
            passwordInput.classList.add("error");
            passwordInput.nextElementSibling.classList.remove("d-none");
            passwordInput.nextElementSibling.innerHTML = errors.password;
            hasError = true;
        }
  
    

        if (!hasError) {
            load.style.display ="inline-block";
            isFetching = true;
 
fetch("/signup", {
    method: "POST",
    headers: {
    'Content-Type': 'application/x-www-form-urlencoded' // Set the Content-Type header
  },
  body: new URLSearchParams(new FormData(form)).toString()
}).then(res => res.json()).then((data)=>{
    isFetching = false;
    load.style.display ="none";

    if(data.message == "Username already taken"){
        usernameInput.classList.add("error");
        usernameInput.nextElementSibling.classList.remove("d-none");
        usernameInput.nextElementSibling.innerHTML = errors.nametaken;
        console.log(data);
    }else if(data.message == "Email already taken"){
        emailInput.classList.add("error");
        emailInput.nextElementSibling.classList.remove("d-none");
        emailInput.nextElementSibling.innerHTML = errors.emailtaken;
        console.log(data);
    }else if(data.message=='Your account has been suspended'){
        logintext.textContent = data.message;

    }else if(data.message=='Success'){
        
       window.location.href = "/verify-email";

    }else if(data.message=="Fail to Send Email"){
        window.location.href = "/verify-email";
    }else{
       logintext.textContent = "Something went wrong. Please try again later."

    }

}).catch((err)=>{
    isFetching = false;
    load.style.display ="none";

})


        }
    
});

});
</script>
<script src="/js/login/auth-menu.js"></script>
</body>
</html>
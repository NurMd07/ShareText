<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification | ShareText</title>
    <link rel="stylesheet" href="/css/login/auth.css">
  </head>
  <body class="auth-page">
    <main class="auth-layout">
      <a class="brand auth-brand heading" href="/" aria-label="ShareText home">
        <span class="brand-mark">
          <img class="brand-logo" src="/images/copy.png" alt="">
        </span>
        <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
      </a>

      <section class="auth-card" aria-labelledby="verification-title">
        <% if (error) { %>
          <header class="auth-card-header">
            <div class="auth-heading-row auth-result-heading">
              <span class="auth-result-icon error" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 8v5m0 3h.01M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <h2 class="auth-title" id="verification-title">We couldn’t send your email</h2>
            </div>
            <p class="auth-description">Your account is ready, but the verification message did not send. Try again below.</p>
          </header>
        <% } else { %>
          <header class="auth-card-header">
            <div class="auth-heading-row auth-result-heading">
              <span class="auth-result-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-11Z" stroke="currentColor" stroke-width="1.8"/>
                  <path d="m5 7 7 5.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <h2 class="auth-title" id="verification-title">Check your inbox</h2>
            </div>
            <p class="auth-description">We sent you a verification link. It’s valid for 30 minutes. If you don’t see it, check your spam or junk folder.</p>
          </header>
        <% } %>

        <div class="auth-resend-section">
          <p class="auth-resend-prompt">
            <% if (error) { %>
              Need another attempt?
            <% } else { %>
              Didn’t receive the email?
            <% } %>
          </p>
          <div class="auth-resend-row">
            <button type="button" class="auth-resend resend">
              <% if (error) { %>Resend link<% } else { %>Resend email<% } %>
            </button>
            <span class="timer hidden" aria-live="polite"></span>
          </div>
        </div>

        <p class="auth-footer"><a class="auth-link" href="/login">Already verified? Sign in</a></p>
      </section>
    </main>

    <script>
      const resend = document.querySelector(".resend");
      const timer = document.querySelector(".timer");

      resend.addEventListener("click", () => {
        if (resend.style.cursor === "not-allowed") {
          return;
        }

        sendVerificationEmail();
      });

      function sendVerificationEmail() {
        resend.style.cursor = "not-allowed";
        resend.textContent = "Sending…";

        let timeLeft = 90;
        timer.textContent = timeLeft;
        timer.classList.remove("hidden");

        const interval = setInterval(() => {
          timeLeft -= 1;
          timer.textContent = timeLeft;

          if (timeLeft <= 0) {
            clearInterval(interval);
            resend.style.cursor = "pointer";
            resend.textContent = "Resend email";
            timer.classList.add("hidden");
            resend.classList.remove("wait");
          }
        }, 1000);

        fetch("/resend-verification-email", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ msg: "verify" }),
        })
          .then((response) => response.json())
          .then((data) => {
            if (data.status === "success") {
              resend.textContent = "Sent successfully";
              resend.classList.add("success");
              setTimeout(() => {
                resend.textContent = "Resend in…";
                resend.classList.remove("success");
                resend.classList.add("wait");
              }, 5000);
              return;
            }

            if (data.message === "Email Already Verified") {
              resend.textContent = "Email already verified";
              timer.classList.add("hidden");
              clearInterval(interval);
              return;
            }

            if (data.message === "Email Not Found") {
              resend.textContent = "Email not found";
              timer.classList.add("hidden");
              clearInterval(interval);
              return;
            }

            resend.textContent = data.message === "cooldown" ? "Resend in…" : "Failed to send";
            if (data.message !== "cooldown") {
              resend.classList.add("wait");
            }
          })
          .catch(() => {
            resend.textContent = "Failed to send";
            resend.classList.add("wait");
          });
      }
    </script>
  </body>
</html>

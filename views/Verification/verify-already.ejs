<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Already Verified | ShareText</title>
    <link rel="stylesheet" href="/css/login/auth.css">
  </head>
  <body class="auth-page">
    <main class="auth-layout">
      <a class="brand auth-brand heading" href="/" aria-label="ShareText home">
        <span class="brand-mark">
          <img class="brand-logo" src="/images/copy.png" alt="">
        </span>
        <h1 class="brand-title"><span>Share</span><span class="brand-title-accent">Text</span></h1>
      </a>

      <section class="auth-card" aria-labelledby="verify-already-title">
        <header class="auth-card-header">
          <div class="auth-heading-row auth-result-heading">
            <span class="auth-result-icon success" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="m5 12.5 4.5 4.5L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <h2 class="auth-title" id="verify-already-title">Email already verified</h2>
          </div>
          <p class="auth-description">Your email address is already verified. Sign in to continue to ShareText.</p>
        </header>
        <div class="auth-result-actions">
          <a href="/login" class="auth-submit">Continue to sign in</a>
          <a href="/" class="auth-link auth-result-secondary">Back to ShareText</a>
        </div>
      </section>
    </main>
  </body>
</html>
